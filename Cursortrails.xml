<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- Simple configuration frame for Cursortrails -->
    <Frame name="CursortrailsConfigFrame" frameStrata="DIALOG" toplevel="true"
           parent="UIParent" hidden="true" movable="true" enableMouse="true">
        <Size>
            <AbsDimension x="360" y="260"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border" tile="true">
            <TileSize><AbsValue val="32"/></TileSize>
            <EdgeSize><AbsValue val="32"/></EdgeSize>
            <BackgroundInsets>
                <AbsInset left="5" right="5" top="5" bottom="5"/>
            </BackgroundInsets>
        </Backdrop>

        <TitleRegion setAllPoints="true"/>

        <Scripts>
            <OnLoad>
                this:RegisterForDrag("LeftButton");
            </OnLoad>
            <OnDragStart>
                this:StartMoving();
            </OnDragStart>
            <OnDragStop>
                this:StopMovingOrSizing();
            </OnDragStop>
            <OnShow>
                Cursortrails_Config_Refresh();
            </OnShow>
        </Scripts>

        <Layers>
            <Layer level="ARTWORK">
                <!-- Title -->
                <FontString name="CursortrailsConfigTitle" inherits="GameFontNormalLarge"
                            text="Cursortrails Settings">
                    <Anchors>
                        <Anchor point="TOP">
                            <Offset>
                                <AbsDimension x="0" y="-16"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Frames>

            <!-- Enabled checkbox -->
            <CheckButton name="CursortrailsEnableCheck" inherits="OptionsCheckButtonTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="20" y="-45"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        if this:GetChecked() then
                            Cursortrails_Config_SetEnabled(1)
                        else
                            Cursortrails_Config_SetEnabled(0)
                            Cursortrails_ClearTrail()
                        end
                    </OnClick>
                    <OnShow>
                        this:SetChecked(Cursortrails_Config_GetEnabled());
                    </OnShow>
                </Scripts>
            </CheckButton>

            <FontString name="CursortrailsEnableLabel" inherits="GameFontNormal">
                <Anchors>
                    <Anchor point="LEFT" relativeTo="CursortrailsEnableCheck" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="4" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Color r="1.0" g="1.0" b="1.0"/>
                <Text>Enable cursor trail</Text>
            </FontString>

            <!-- MaxPoints slider -->
            <Slider name="CursortrailsMaxPointsSlider" inherits="OptionsSliderTemplate">
                <Size>
                    <AbsDimension x="220" y="16"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="40" y="-80"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        getglobal(this:GetName().."Text"):SetText("Max Points");
                        getglobal(this:GetName().."Low"):SetText("5");
                        getglobal(this:GetName().."High"):SetText("80");
                        this:SetMinMaxValues(5, 80);
                        this:SetValueStep(1);
                    </OnLoad>
                    <OnShow>
                        this:SetValue(Cursortrails_Config_GetMaxPoints());
                    </OnShow>
                    <OnValueChanged>
                        Cursortrails_Config_SetMaxPoints(this:GetValue());
                    </OnValueChanged>
                </Scripts>
            </Slider>

            <!-- DotSize slider -->
            <Slider name="CursortrailsDotSizeSlider" inherits="OptionsSliderTemplate">
                <Size>
                    <AbsDimension x="220" y="16"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="40" y="-110"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        getglobal(this:GetName().."Text"):SetText("Dot Size");
                        getglobal(this:GetName().."Low"):SetText("4");
                        getglobal(this:GetName().."High"):SetText("32");
                        this:SetMinMaxValues(4, 32);
                        this:SetValueStep(1);
                    </OnLoad>
                    <OnShow>
                        this:SetValue(Cursortrails_Config_GetDotSize());
                    </OnShow>
                    <OnValueChanged>
                        Cursortrails_Config_SetDotSize(this:GetValue());
                    </OnValueChanged>
                </Scripts>
            </Slider>

            <!-- TrailLength slider -->
            <Slider name="CursortrailsTrailLengthSlider" inherits="OptionsSliderTemplate">
                <Size>
                    <AbsDimension x="220" y="16"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="40" y="-140"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        getglobal(this:GetName().."Text"):SetText("Trail Length (sec)");
                        getglobal(this:GetName().."Low"):SetText("0.3");
                        getglobal(this:GetName().."High"):SetText("3.0");
                        this:SetMinMaxValues(0.3, 3.0);
                        this:SetValueStep(0.1);
                    </OnLoad>
                    <OnShow>
                        this:SetValue(Cursortrails_Config_GetTrailLength());
                    </OnShow>
                    <OnValueChanged>
                        Cursortrails_Config_SetTrailLength(this:GetValue());
                    </OnValueChanged>
                </Scripts>
            </Slider>

            <!-- UpdateRate slider -->
            <Slider name="CursortrailsUpdateRateSlider" inherits="OptionsSliderTemplate">
                <Size>
                    <AbsDimension x="220" y="16"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="40" y="-170"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        getglobal(this:GetName().."Text"):SetText("Update Rate (sec)");
                        getglobal(this:GetName().."Low"):SetText("0.01");
                        getglobal(this:GetName().."High"):SetText("0.05");
                        this:SetMinMaxValues(0.01, 0.05);
                        this:SetValueStep(0.005);
                    </OnLoad>
                    <OnShow>
                        this:SetValue(Cursortrails_Config_GetUpdateRate());
                    </OnShow>
                    <OnValueChanged>
                        Cursortrails_Config_SetUpdateRate(this:GetValue());
                    </OnValueChanged>
                </Scripts>
            </Slider>

            <!-- MinDistance slider -->
            <Slider name="CursortrailsMinDistanceSlider" inherits="OptionsSliderTemplate">
                <Size>
                    <AbsDimension x="220" y="16"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset>
                            <AbsDimension x="40" y="-200"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        getglobal(this:GetName().."Text"):SetText("Min Distance");
                        getglobal(this:GetName().."Low"):SetText("0.1");
                        getglobal(this:GetName().."High"):SetText("10");
                        this:SetMinMaxValues(0.1, 10.0);
                        this:SetValueStep(0.1);
                    </OnLoad>
                    <OnShow>
                        this:SetValue(Cursortrails_Config_GetMinDistance());
                    </OnShow>
                    <OnValueChanged>
                        Cursortrails_Config_SetMinDistance(this:GetValue());
                    </OnValueChanged>
                </Scripts>
            </Slider>

            <!-- Color picker button + swatch -->
            <Button name="CursortrailsColorButton" inherits="UIPanelButtonTemplate" text="Color...">
                <Size>
                    <AbsDimension x="80" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-40" y="-80"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        Cursortrails_OpenColorPicker();
                    </OnClick>
                </Scripts>
            </Button>

            <Frame name="CursortrailsColorSwatch" parent="CursortrailsConfigFrame">
                <Size>
                    <AbsDimension x="24" y="24"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="CursortrailsColorButton" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="8" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="ARTWORK">
                        <Texture name="CursortrailsColorSwatchTexture">
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                                <Anchor point="BOTTOMRIGHT"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>

            <!-- Close button -->
            <Button name="CursortrailsCloseButton" inherits="UIPanelButtonTemplate" text="Close">
                <Size>
                    <AbsDimension x="80" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="BOTTOM">
                        <Offset>
                            <AbsDimension x="0" y="16"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        this:GetParent():Hide();
                    </OnClick>
                </Scripts>
            </Button>

        </Frames>
    </Frame>

</Ui>
